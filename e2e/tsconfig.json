{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2024", "dom", "dom.iterable", "esnext.disposable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"]
}
